// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(uuid())
  name          String
  subscription  String   @default("FREE") // FREE, PRO
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  patients      Patient[]
  settings      Settings?
  appointments  Appointment[]
  notes         Note[]
  availability  Availability[]
}

model User {
  id            String   @id @default(uuid())
  tenantId      String
  clerkId       String   @unique
  email         String   @unique
  role          String   @default("OWNER") // OWNER, ASSISTANT
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Patient {
  id            String   @id @default(uuid())
  tenantId      String
  firstName     String
  lastName      String
  phone         String
  email         String?
  pesel         String?
  birthDate     DateTime?
  guardianName  String?
  gdprConsent   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  appointments  Appointment[]
  notes         Note[]
}

model Appointment {
  id            String   @id @default(uuid())
  tenantId      String
  patientId     String
  startDateTime DateTime
  endDateTime   DateTime
  status        String   // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  type          String   // CONSULTATION, THERAPY
  price         Decimal
  isPaid        Boolean  @default(false)
  recurrenceId  String?  // Group ID for recurring series
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  patient       Patient  @relation(fields: [patientId], references: [id])
  note          Note?
}

model Note {
  id            String   @id @default(uuid())
  tenantId      String
  patientId     String
  appointmentId String?  @unique
  content       String   // Encrypted
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  patient       Patient  @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  history       NoteHistory[]
}

model NoteHistory {
  id            String   @id @default(uuid())
  noteId        String
  content       String   // Encrypted content at that version
  version       Int
  createdAt     DateTime @default(now())

  note          Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model Availability {
  id            String   @id @default(uuid())
  tenantId      String
  dayOfWeek     Int      // 0=Sunday, 1=Monday...
  startTime     String   // "08:00"
  endTime       String   // "16:00"

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Settings {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  companyName   String?
  nip           String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}
